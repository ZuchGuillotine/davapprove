API_DOMAIN=api.davapprove.com
# Dedicated MCP host (engine service). Point its DNS at this server too.
MCP_DOMAIN=mcp.davapprove.com
CORS_ORIGINS=https://davapprove.com,https://www.davapprove.com
# Where MCP report links send people (the website, not the API).
PUBLIC_APP_URL=https://davapprove.com
# Beta: every report is served; responses say whether it would have required payment.
REPORTS_REQUIRE_PAYMENT=false
FREE_REPORTS=1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Worker container only. Never put this in web/.env or a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
MAX_PDF_BYTES=52428800
# Enable after configuring the Supabase Send Email hook or SMTP; see auth-email/README.md.
EMAIL_DELIVERY_ENABLED=false
# Optional server-only AI proxy; see ai-proxy/README.md.
AI_BASE_URL=https://davapprove-ai-proxy.example.workers.dev/v1
AI_API_KEY=
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_INPUT_USD_PER_MILLION=0.293
AI_OUTPUT_USD_PER_MILLION=2.253
AI_MONTHLY_USD=25

# Platform-funded OpenAI processing (worker only).
AI_PROVIDER=openai
OPENAI_API_KEY=
# For OpenAI use these values instead of the legacy model/rates above.
# AI_MODEL=gpt-4.1-mini-2025-04-14
# AI_INPUT_USD_PER_MILLION=0.40
# AI_OUTPUT_USD_PER_MILLION=1.60

# Automated pre-check cascade (server-only; both providers share the $25 cap):
# AI_PROVIDER=cascade
# AI_MODEL=gpt-6.1-sol
# TYPESAFE_API_KEY=configure-in-protected-server-environment
# AI_INPUT_USD_PER_MILLION=2
# AI_OUTPUT_USD_PER_MILLION=10
