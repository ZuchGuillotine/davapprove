API_DOMAIN=api.example.com
CORS_ORIGINS=https://davapprove-preview.example.workers.dev
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Worker container only. Never put this in web/.env or a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
MAX_PDF_BYTES=52428800
EMAIL_DELIVERY_ENABLED=false
# Optional server-only AI proxy; see ai-proxy/README.md.
AI_BASE_URL=https://davapprove-ai-proxy.example.workers.dev/v1
AI_API_KEY=
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_INPUT_USD_PER_MILLION=0.293
AI_OUTPUT_USD_PER_MILLION=2.253
AI_MONTHLY_USD=5
