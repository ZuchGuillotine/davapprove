# Public API origin; omit for same-origin /api or local Vite proxy.
VITE_API_URL=
# Optional public auth config; alternatively supplied by /api/v1/config.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only enable after SMTP or the Send Email hook is verified. API flag takes precedence.
VITE_EMAIL_DELIVERY_ENABLED=false
